{
  "languageId": "dart",
  "version": "1.0.1",
  "icon": "Target",
  "color": "#00b4ab",
  "extensions": [
    "dart"
  ],
  "serverId": "dart",
  "server": {
    "strategy": "exe-search",
    "command": "dart",
    "args": [
      "language-server",
      "--client-id",
      "deck.editor"
    ]
  },
  "rootMarker": "pubspec.yaml",
  "debug": {
    "type": "dart",
    "install": "Needs the Dart or Flutter SDK on PATH, which includes the debugger (dart debug_adapter).",
    "adapter": {
      "strategy": "exe-search",
      "command": "dart",
      "args": [
        "debug_adapter"
      ]
    },
    "launch": {
      "program": "${file}",
      "cwd": "${fileDirname}",
      "debugSdkLibraries": false,
      "debugExternalPackageLibraries": false
    },
    "launchUnless": "^\\s*import\\s+['\"](package:flutter/|dart:ui)"
  },
  "initializationOptions": {
    "suggestFromUnimportedLibraries": true
  },
  "configuration": {
    "dart": {
      "completeFunctionCalls": true,
      "enableSnippets": true
    }
  },
  "statusNotifications": {
    "$/analyzerStatus": {
      "phase": "ready",
      "flagParam": "isAnalyzing",
      "detailWhenTrue": "analyzing\u2026",
      "detailWhenFalse": "ready"
    }
  },
  "extraTokenColors": [
    {
      "token": "variable.interpolation",
      "foreground": "9CDCFE"
    },
    {
      "token": "property.interpolation",
      "foreground": "9CDCFE"
    }
  ]
}
